# Tool and dependency versions: the single source of truth for the Makefile
# (`include`), hack/*.sh and CI (`source`), the CI image (.github/ci-image)
# and the devcontainer (hack/tools/install.sh).
#
# Plain KEY=value lines only (no quotes, no spaces): this file is read by both
# make and bash. Renovate updates every value that has a `# renovate:` comment
# (see renovate.json).

# Kubernetes version of envtest (minor) and kubectl; also the default
# kubeconform target of the chart tests.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION=1.37.2

# k3s node image of the e2e cluster; keep the minor in line with KUBERNETES_VERSION.
# renovate: datasource=docker depName=rancher/k3s
K3S_VERSION=v1.37.1-k3s1

# renovate: datasource=github-releases depName=k3d-io/k3d
K3D_VERSION=v5.9.0

# renovate: datasource=github-releases depName=tilt-dev/tilt
TILT_VERSION=v0.37.8

# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.2

# helm-docs renders the chart README (run via `go run`, not installed).
# renovate: datasource=github-releases depName=norwoodj/helm-docs
HELM_DOCS_VERSION=v1.14.2

# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCI_LINT_VERSION=v2.15.0

# renovate: datasource=github-releases depName=mikefarah/yq
YQ_VERSION=v4.54.3

# oras pushes the ArtifactHub repository metadata next to the chart (release-chart.yaml).
# renovate: datasource=github-releases depName=oras-project/oras
ORAS_VERSION=v1.3.4

# csi-driver-smb chart the e2e environment installs (the healer's counterpart).
# renovate: datasource=helm depName=csi-driver-smb registryUrl=https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
CSI_DRIVER_SMB_VERSION=1.20.4
CSI_DRIVER_SMB_REPO=https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
